{
  "name": "@delicti-protocol/sdk",
  "version": "0.15.2",
  "description": "Spending limits for AI agents that hold across calls and chains, proven by Flare's FDC and enforced by a bond: TypeScript SDK, watchers and sentinel for DELICTI. x402 · stablecoins · XRPL · Flare.",
  "keywords": [
    "agent-accountability",
    "agent-wallets",
    "ai-agents",
    "corpus-delicti",
    "delicti",
    "eip-3009",
    "fdc",
    "flare",
    "ftso",
    "mcp",
    "sdk",
    "sentinel",
    "spending-limits",
    "stablecoins",
    "typescript",
    "viem",
    "watcher",
    "x402",
    "xrp-ledger",
    "xrpl"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Alan Dziuba (Dziuba Technology)",
  "homepage": "https://github.com/dziuba0x/delicti/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dziuba0x/delicti.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/dziuba0x/delicti/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "delicti": "dist/cli.js",
    "delicti-watch": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "abi": "node scripts/gen-abi.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "watch:erc20": "tsx src/cli.ts erc20",
    "sentinel": "tsx src/cli.ts sentinel"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
