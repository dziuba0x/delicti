# Copy to .env (gitignored). Every script in scripts/ sources it.
# Use a throwaway key with Coston2 test funds only: https://faucet.flare.network/coston2
PRIVATE_KEY=0x...
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc

# FDC verifier and data-availability layer — Flare's public testnet endpoints
# (see https://dev.flare.network/fdc/overview if they move).
VERIFIER_URL=https://fdc-verifiers-testnet.flare.network
VERIFIER_API_KEY=00000000-0000-0000-0000-000000000000
DA_URL=https://ctn2-data-availability.flare.network

