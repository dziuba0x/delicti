{
  "name": "@delicti/sdk",
  "version": "0.15.0",
  "description": "TypeScript SDK and watcher for DELICTI: mandates, bonds, FDC evidence, and the bot that files dockets and convicts.",
  "keywords": [
    "delicti",
    "ai-agents",
    "agent-accountability",
    "watcher",
    "sentinel",
    "flare",
    "fdc",
    "xrpl",
    "x402",
    "stablecoins",
    "mcp",
    "viem",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Alan Dziuba (Dziuba Technology)",
  "homepage": "https://github.com/dziuba0x/delicti/tree/main/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dziuba0x/delicti.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/dziuba0x/delicti/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "delicti-watch": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "abi": "node scripts/gen-abi.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "watch:erc20": "tsx src/cli.ts erc20",
    "sentinel": "tsx src/cli.ts sentinel"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0"
  }
}
